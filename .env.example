# Cadenas de conexión SQL Server (ajustar instancia si no es .\SQLEXPRESS)
DB_CONNECTION_STRING_IDENTIDAD=Server=.\SQLEXPRESS;Database=AromanticaIdentidadDB;Trusted_Connection=True;TrustServerCertificate=True;
DB_CONNECTION_STRING_CATALOGO=Server=.\SQLEXPRESS;Database=AromanticaCatalogoDB;Trusted_Connection=True;TrustServerCertificate=True;
DB_CONNECTION_STRING_COMERCIOS=Server=.\SQLEXPRESS;Database=AromanticaComerciosDB;Trusted_Connection=True;TrustServerCertificate=True;
DB_CONNECTION_STRING_COTIZACIONES=Server=.\SQLEXPRESS;Database=AromanticaCotizacionesDB;Trusted_Connection=True;TrustServerCertificate=True;

# Clave secreta JWT (mínimo 32 caracteres — NO subir valores reales al repositorio)
JWT_SECRET_KEY=<INSERTAR_CLAVE_SECRETA_JWT_MIN_32_CARACTERES>

# URLs internas para IHttpClientFactory en Cotizaciones.API
CATALOGO_API_URL=http://localhost:5102
COMERCIOS_API_URL=http://localhost:5103
ASPNETCORE_ENVIRONMENT=Development
